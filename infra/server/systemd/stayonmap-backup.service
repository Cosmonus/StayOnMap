# StayOnMap — nightly PostgreSQL backup (oneshot, driven by the .timer beside
# this file).
#
# Install:
#   sudo cp /srv/stayonmap/infra/server/systemd/stayonmap-backup.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now stayonmap-backup.timer
#
# Logs:    journalctl -u stayonmap-backup -n 50
# Run now: sudo systemctl start stayonmap-backup
[Unit]
Description=StayOnMap nightly PostgreSQL backup
Documentation=file:///srv/stayonmap/infra/server/README-server.md
# The dump needs the database up. Wants= rather than Requires= so a manual run
# during a Postgres restart queues instead of failing outright.
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/usr/bin/bash /srv/stayonmap/infra/server/backup.sh

# The script sources /etc/stayonmap/api.env itself (DATABASE_URL plus the
# optional BACKUP_* offsite target), so no secret is named in this unit.

# A hung dump must not sit there until the next one is due. backup.sh's own
# failure is loud (set -euo pipefail + a pg_restore --list verification), and
# a failed oneshot shows up in `systemctl list-units --failed`.
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
