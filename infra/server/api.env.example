# ============================================================================
# StayOnMap API — production environment file
#
# On the server this lives at /etc/stayonmap/api.env (chmod 600, owned by the
# deploy user). setup-server.sh copies THIS template there on first run.
#
# It is read in two places, so quoting rules matter:
#   1. systemd  — EnvironmentFile= in stayonmap-api.service (the running API).
#   2. deploy.sh — sourced (`set -a; . api.env`) so DATABASE_URL reaches the
#      Prisma CLI and VITE_* reach the frontend build.
# Ubuntu 24.04's systemd (v255) strips matching surrounding quotes, and shell
# `source` needs them, so: QUOTE any value containing  & ? < > # or a space.
# DATABASE_URL (has `&`) and MAIL_FROM (has `<` `>` and spaces) MUST stay quoted.
#
# NO REAL SECRETS IN THIS .example FILE. Fill the real values on the box only.
# ============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
# The canonical public origin. Same-origin behind nginx, so this is also the
# CORS allow value. ALWAYS www — the apex 301-redirects and drops the path.
FRONTEND_URL=https://www.stayonmap.com
# The backend's own public origin (OAuth callbacks resolve against this).
API_PUBLIC_URL=https://www.stayonmap.com

# ── Database — the LOCAL PostgreSQL 16 on this box ──────────────────────────
# Postgres listens on localhost only (never opened in ufw). setup-server.sh
# prints the generated password once — paste it here. Keep the surrounding
# quotes (the `&` breaks an unquoted source).
DATABASE_URL="postgresql://stayonmap:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:5432/stayonmap?connection_limit=10&pool_timeout=20"

# ── Redis — STAYS EXTERNAL (Upstash) ────────────────────────────────────────
# Do NOT move this to the box. The rediss:// string comes from the Upstash
# console (or the current production box's api.env when replacing a box).
# Enables pin cache, the rate limiters, Socket.io adapter, spatial API budget.
REDIS_URL=rediss://default:password@your-endpoint.upstash.io:6379

# ── Supabase — STAYS EXTERNAL (file storage only) ───────────────────────────
# Property images live here; not a database.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── JWT secrets — if replacing a box, COPY VERBATIM, DO NOT REGENERATE ──────
# Regenerating JWT_SECRET signs out every logged-in user; regenerating
# ADMIN_JWT_SECRET signs out every admin. When migrating to a new box they
# must stay identical to the current production values (/etc/stayonmap/api.env
# on the old box). Must differ from each other and be >= 32 chars, or the API
# refuses to boot (config/env.js).
JWT_SECRET=COPY_EXACT_CURRENT_PRODUCTION_VALUE
ADMIN_JWT_SECRET=COPY_EXACT_CURRENT_PRODUCTION_VALUE_DIFFERENT
JWT_EXPIRES_IN=7d

# ── AI provider: 'stub' | 'anthropic' ───────────────────────────────────────
AI_PROVIDER=stub
# ANTHROPIC_API_KEY=

# ── Google Maps (server-side key — unrestricted/IP-restricted, NOT the
#    browser referrer key) — Geocoding, Places, Elevation, spatial layer ─────
GOOGLE_MAPS_KEY=your_server_key_here
SPATIAL_DAILY_API_BUDGET=2000
# DATA_GOV_API_KEY=your_data_gov_in_key_here

# ── Routing (OSRM) — now on THIS box once infra/routing/setup-osrm.sh runs ──
# Localhost: OSRM serves :5000 and is NOT exposed in ufw. Leave blank until
# OSRM is up; absent = every distance stays haversine (a supported state).
ROUTING_URL=http://127.0.0.1:5000

# ── Email (lib/mailer.js) ───────────────────────────────────────────────────
# Production uses ZeptoMail (HTTPS API — chosen when the previous host blocked
# SMTP). On a plain VM outbound SMTP works too, but keeping ZeptoMail avoids
# re-verifying DNS. Leave all unset to make email a logged no-op.
MAIL_PROVIDER=zeptomail
MAIL_FROM="StayOnMap <noreply@stayonmap.com>"
MAIL_DAILY_CAP=500
# ZEPTOMAIL_TOKEN=
# ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
# --- alternatives (see backend/.env.example for the full notes) ---
# SMTP_HOST=  SMTP_PORT=465  SMTP_USER=  SMTP_PASS=
# RESEND_API_KEY=
# BREVO_API_KEY=

# ── Push Notifications (Web Push / VAPID) — keep the existing prod keypair ──
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@stayonmap.com

# ── Error monitoring (optional — no-ops when blank) ─────────────────────────
SENTRY_DSN=

# ── Social login (optional — provider hidden in UI unless BOTH are set) ─────
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# ── Admin seed (only read by `prisma db seed`, not by the running API) ──────
# Not needed when the DB is migrated in from an existing box (the Admin row
# already exists). Only used for a from-scratch DB.
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD=

# ============================================================================
# FRONTEND BUILD-TIME VARS — read by deploy.sh, baked into the static bundle.
# Harmless to the API process (it ignores VITE_*). Keeping them here means one
# env file, not two.
#
# NOTE: deploy.sh HARD-CODES VITE_API_BASE_URL=/api/v1 at build time and does
# NOT read it from this file — that relative path is what makes the SPA call
# the API and Socket.io SAME-ORIGIN through nginx (no CORS, no baked hostname).
# Do not set VITE_API_BASE_URL here expecting it to take effect.
# ============================================================================
VITE_GOOGLE_MAPS_API_KEY=your_browser_referrer_restricted_maps_key
VITE_SENTRY_DSN=

# ============================================================================
# BACKUPS — offsite target (backup.sh sources this file)
#
# Set ONE. Unset means dumps live only on the same disk as the database, which
# does not survive the event backups exist for. Configured here rather than by
# editing backup.sh because that file is git-tracked and deploy.sh pulls over
# it on every merge.
#
# Requires the matching CLI on the box and credentials for it:
#   gsutil (GCS)  — a service account with Storage Object Creator on the bucket
#   awscli (S3)   — an IAM user/role with s3:PutObject
#   rsync         — an SSH key the deploy user can use non-interactively
# ============================================================================
BACKUP_GCS_BUCKET=
BACKUP_S3_URI=
BACKUP_RSYNC_TARGET=
