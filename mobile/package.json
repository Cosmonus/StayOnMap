    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest"
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.0.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-imports": "^2.0.0",
    "babel-preset-expo": "^57.0.1",
