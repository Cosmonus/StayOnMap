# Backend REST API base (includes /api/v1) — socket URL is derived from this
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# iOS client key (iOS bundle ID restriction, NOT the backend server key)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_ios_key

# Android client key (Android app restriction: package name + SHA-1 —
# a single Google Cloud key can't be restricted to both Android and iOS)
GOOGLE_MAPS_API_KEY_ANDROID=your_google_maps_android_key
