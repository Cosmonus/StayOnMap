# Same Supabase project as frontend/backend
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend REST API base (includes /api/v1) — socket URL is derived from this
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Client-restricted key (Android/iOS app restriction, NOT the backend server key)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_client_key
