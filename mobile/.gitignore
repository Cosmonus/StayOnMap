# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Play Console service account key (eas submit credential — never commit)
serviceAccountKey*.json

# `eas credentials` local sync — plaintext keystore + key passwords, and the
# keystore it points at. *.jks already covers credentials/android/keystore.jks;
# this covers the manifest that holds the passwords for it.
credentials.json
credentials/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
