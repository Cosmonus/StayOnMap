# ─────────────────────────────────────────────
# Secrets — never commit these
# ─────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem
*.key
backend/.env
frontend/.env

# ─────────────────────────────────────────────
# Private planning & product docs — no markdown docs of any kind go to git;
# they document internal architecture, known bugs, and security posture,
# which is itself a security exposure if pushed to the remote.
# Exception: README.md is the dev-onboarding doc and is meant to be public.
# ─────────────────────────────────────────────
*.md
!README.md
.claude/
docs/
staynear-summary.html

# ─────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─────────────────────────────────────────────
# Build output
# ─────────────────────────────────────────────
dist/
build/
out/
.output/
backend/public/

# ─────────────────────────────────────────────
# Prisma generated
# ─────────────────────────────────────────────
# Keep: prisma/schema.prisma, prisma/migrations/ — these ARE committed
# Ignore: generated client (regenerated via `prisma generate`)
backend/node_modules/
backend/src/generated/

# ─────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ─────────────────────────────────────────────
# OS & editor noise
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─────────────────────────────────────────────
# Test & coverage
# ─────────────────────────────────────────────
coverage/
.nyc_output/

# ─────────────────────────────────────────────
# MCP config (contains project references)
# ─────────────────────────────────────────────
.mcp.json

# ─────────────────────────────────────────────
# Misc
# ─────────────────────────────────────────────
.cache/
.turbo/
*.tsbuildinfo

graphify-out/

# ─────────────────────────────────────────────
# Metro data engine workspace — raw Overpass caches and intermediate
# candidates are re-derivable scratch (MBs per city); the committed engine
# state is metro-curation.json, metro-structure-snapshot.json,
# metro-qa-report.json and the shipped src/data/metro-lines/ files.
# ─────────────────────────────────────────────
backend/data/metro-raw/
backend/data/metro-candidates/
backend/data/metro-compare/

# design-sync (claude.ai/design) — local-only, never pushed
.design-sync/
.ds-sync/
ds-bundle/
frontend/.ds-styles.css
