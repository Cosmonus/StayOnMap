# API — set to Render backend URL in production
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Google Maps (public key — restrict to your domain in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# App
VITE_APP_ENV=development

# Optional — src/lib/sentry.js no-ops without it
VITE_SENTRY_DSN=
