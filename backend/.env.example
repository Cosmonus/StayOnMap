# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Supabase — File Storage ONLY (DB is Railway Postgres) ─────────────────────
# Auth (both users and admins) uses custom JWTs — see below.
# Supabase is used only for: File storage (supabase.storage — property images).
# The Supabase database is NOT used. DATABASE_URL points to Railway instead.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Database — Railway PostgreSQL (Prisma) ────────────────────────────────────
# Get this from: Railway dashboard → your project → PostgreSQL plugin → Connect tab
# Format: postgresql://postgres:<password>@<host>.railway.app:<port>/railway
# connection_limit/pool_timeout keep Prisma's pool bounded per instance —
# important once you run multiple backend instances against one Postgres
# (each instance opens its own pool; Postgres has a fixed max_connections).
DATABASE_URL=postgresql://postgres:password@containers-us-west-xxx.railway.app:6543/railway?connection_limit=5&pool_timeout=10

# ── Redis (Upstash or any ioredis-compatible provider) ───────────────────────
# Optional in dev — cacheGet/cacheSet, the rate limiters, and the Socket.io
# cross-instance adapter all no-op without it. Required once you run more
# than one backend instance (rate limiting and sockets need shared state).
# Use the "Redis"/ioredis connection string (rediss://...), NOT the REST
# API url+token pair shown elsewhere in most providers' dashboards.
REDIS_URL=rediss://default:password@your-endpoint.upstash.io:6379

# ── Admin JWT (custom — separate secret from JWT_SECRET, never mix) ──────────
ADMIN_JWT_SECRET=change_this_to_a_long_random_string_min_32_chars

# ── User JWT (custom — separate secret from ADMIN_JWT_SECRET, never mix) ─────
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# ── Admin seed credentials (used only by prisma/seed.js) ─────────────────────
ADMIN_SEED_EMAIL=admin@stayonmap.com
ADMIN_SEED_PASSWORD=Admin@1234!

# ── Storage (Cloudinary — for uploads) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI provider: 'stub' | 'openai' | 'anthropic' ─────────────────────────────
AI_PROVIDER=stub

# ── Google Maps (server-side — Geocoding, Places Autocomplete/Nearby Search,
# Elevation) — an UNRESTRICTED or IP-restricted key, NOT the HTTP-referrer
# key used by the web frontend's JS Maps SDK (that restriction type rejects
# any request without a browser Referer, which every server-side/mobile
# request lacks). Used by trust.service.js and features/places.
GOOGLE_MAPS_KEY=your_server_key_here

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Push Notifications (Web Push / VAPID) ────────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@yourdomain.com
