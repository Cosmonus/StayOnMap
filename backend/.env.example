# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Supabase — File Storage ONLY (DB is self-hosted PostgreSQL) ───────────────
# Auth (both users and admins) uses custom JWTs — see below.
# Supabase is used only for: File storage (supabase.storage — property images).
# The Supabase database is NOT used. DATABASE_URL points to Postgres directly.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Database — PostgreSQL (Prisma) ────────────────────────────────────────────
# Local dev: a local Postgres instance. Production runs Postgres on the app VM
# (127.0.0.1) — that template is infra/server/api.env.example, not this file.
# connection_limit/pool_timeout keep Prisma's pool bounded per instance —
# important once you run multiple backend instances against one Postgres
# (each instance opens its own pool; Postgres has a fixed max_connections).
DATABASE_URL=postgresql://postgres:password@localhost:5432/stayonmap?connection_limit=5&pool_timeout=10

# ── Redis (Upstash or any ioredis-compatible provider) ───────────────────────
# Optional in dev — cacheGet/cacheSet, the rate limiters, and the Socket.io
# cross-instance adapter all no-op without it. Required once you run more
# than one backend instance (rate limiting and sockets need shared state).
# Use the "Redis"/ioredis connection string (rediss://...), NOT the REST
# API url+token pair shown elsewhere in most providers' dashboards.
REDIS_URL=rediss://default:password@your-endpoint.upstash.io:6379

# ── JWT secrets ──────────────────────────────────────────────────────────────
# These two MUST be different from each other and from anything in this file.
# The whole user/admin separation rests on that: with one shared secret, a
# user token verifies as an admin token. config/env.js refuses to boot if they
# match, if either is under 32 chars, or if either still says CHANGE_ME.
#
# Generate each one separately:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=CHANGE_ME_generate_a_unique_32_byte_random_hex_string
JWT_SECRET=CHANGE_ME_generate_a_DIFFERENT_32_byte_random_hex_string
JWT_EXPIRES_IN=7d

# ── Admin seed credentials (used only by prisma/seed.js) ─────────────────────
# Never commit a real value, and never use a placeholder that would actually
# work — a previous default here shipped a functioning admin password in git.
# seed.js requires both and enforces a length floor; it provides no default.
ADMIN_SEED_EMAIL=admin@example.invalid
ADMIN_SEED_PASSWORD=CHANGE_ME_use_a_generated_passphrase

# ── AI provider: 'stub' | 'openai' | 'anthropic' ─────────────────────────────
AI_PROVIDER=stub

# ── Google Maps (server-side — Geocoding, Places Autocomplete/Nearby Search,
# Elevation) — an UNRESTRICTED or IP-restricted key, NOT the HTTP-referrer
# key used by the web frontend's JS Maps SDK (that restriction type rejects
# any request without a browser Referer, which every server-side/mobile
# request lacks). Used by trust.service.js and features/places.
GOOGLE_MAPS_KEY=your_server_key_here

# Spatial intelligence (docs/spatial-intelligence.md)
# Hard daily ceiling on billed Google calls made by features/spatial/. The
# number of ~153m cells to describe is driven by where owners choose to list,
# so without a ceiling the spend rate is set by someone other than us. When it
# trips, the layer serves what it already has and reports the rest as missing.
# Only enforced when REDIS_URL is set (the counter is shared state).
SPATIAL_DAILY_API_BUDGET=2000

# CPCB ground-station air quality, via data.gov.in. FREE — registration only,
# no billing, no card. Register at https://www.data.gov.in, then find the key
# under My Account (it is account-level, not per-dataset).
#
# Leaving this unset is a SUPPORTED state, not a misconfiguration: the
# environment module declares `cpcb_station` as an input and leaves it absent,
# which holds its confidence down honestly rather than passing Open-Meteo model
# output off as a measurement. Setting it turns the only MEASURED air-quality
# fact in the system on.
DATA_GOV_API_KEY=your_data_gov_in_key_here

# ── Email (lib/mailer.js) ────────────────────────────────────────────────────
# Four delivery paths, same behaviour. Leave all unconfigured to disable email
# entirely (sends become logged no-ops). The last 10 sends of the daily cap are
# reserved for critical emails (password resets, login codes).
#
#   MAIL_PROVIDER=smtp      (default) — nodemailer to any SMTP endpoint.
#   MAIL_PROVIDER=zeptomail           — Zoho ZeptoMail REST API (production).
#   MAIL_PROVIDER=resend              — Resend's REST API (alternative).
#   MAIL_PROVIDER=brevo               — Brevo's REST API (alternative).
#
# WHICH ONE: SMTP works locally and on the self-hosted VM. Production keeps
# ZeptoMail's HTTPS API (the previous host blocked outbound SMTP, so the HTTPS
# path was built and is retained to avoid re-verifying sender DNS).
MAIL_PROVIDER=smtp
MAIL_FROM=StayOnMap <you@gmail.com>
# Cap: Gmail ~500/day (use 450). ZeptoMail has no fixed daily tier (credit
# based, ~Rs.210 per 10k) — use 500 as a sane runaway guard. Resend free tier
# is 100/day (use 100). Brevo free tier is 300/day (use 300).
MAIL_DAILY_CAP=450

# --- MAIL_PROVIDER=smtp ---
# For Gmail: enable 2-Step Verification, create an App Password (Google Account
# → Security → App passwords), then use smtp.gmail.com:465 with it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password

# --- MAIL_PROVIDER=zeptomail ---
# Zoho's transactional-only mailer (no marketing mail — their terms). 10k free
# trial credits, then credit-based (~Rs.210 / $2.50 per 10k, valid 6 months).
# Setup: zeptomail.zoho.in → create a Mail Agent → verify the sending domain
# (DKIM DNS records) → copy the send-mail token (WITHOUT the "Zoho-enczapikey"
# prefix — the mailer adds it). The API URL depends on the data centre your
# Zoho account lives in: .in signups use api.zeptomail.in (the default),
# .com signups must override with https://api.zeptomail.com/v1.1/email.
# ZEPTOMAIL_TOKEN=...
# ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email

# --- MAIL_PROVIDER=resend ---
# Free tier: 100 emails/day / 3,000 per month, no card. Create a key at
# https://resend.com → API Keys. Verify the MAIL_FROM domain in Resend first
# (Domains → Add Domain → set the DNS records), or every send 403s.
# RESEND_API_KEY=re_...

# --- MAIL_PROVIDER=brevo ---
# Free tier: 300 emails/day, no card. Create a key at
# https://app.brevo.com → SMTP & API → API Keys. Verify the MAIL_FROM domain
# (or at least the sender address) in Brevo first, or every send 401/400s.
# BREVO_API_KEY=xkeysib-...

# ── Push Notifications (Web Push / VAPID) ────────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ── Error Monitoring (optional — lib/sentry.js no-ops without it) ───────────
SENTRY_DSN=

# ── Social login (all optional — a provider without BOTH vars simply doesn't
# appear in the UI). Creating these apps is operator work: each provider's
# console needs the callback URL
#   <API_PUBLIC_URL>/api/v1/auth/oauth/<provider>/callback
# registered. Full walkthrough: docs/auth-providers-setup.md
API_PUBLIC_URL=http://localhost:4000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=







# ── Routing (optional) — self-hosted OSRM for measured walking distances.
# Provision with infra/routing/ (Hetzner CX32 ~€7/mo). Unset = every distance
# stays haversine, exactly as before; the router can only improve numbers.
ROUTING_URL=
