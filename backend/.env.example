# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Supabase — Auth + Storage ONLY (DB is now Railway Postgres) ───────────────
# Supabase is used for:
#   1. JWT verification  (supabase.auth.getUser)
#   2. Password resets   (supabase.auth.resetPasswordForEmail)
#   3. File storage      (supabase.storage — property images)
# The Supabase database is NOT used. DATABASE_URL points to Railway instead.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# ── Database — Railway PostgreSQL (Prisma) ────────────────────────────────────
# Get this from: Railway dashboard → your project → PostgreSQL plugin → Connect tab
# Format: postgresql://postgres:<password>@<host>.railway.app:<port>/railway
DATABASE_URL=postgresql://postgres:password@containers-us-west-xxx.railway.app:6543/railway

# ── Admin JWT (custom — separate from Supabase) ───────────────────────────────
ADMIN_JWT_SECRET=change_this_to_a_long_random_string_min_32_chars

# ── Admin seed credentials (used only by prisma/seed.js) ─────────────────────
ADMIN_SEED_EMAIL=admin@stayonmap.com
ADMIN_SEED_PASSWORD=Admin@1234!

# ── Storage (Cloudinary — for uploads) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI provider: 'stub' | 'openai' | 'anthropic' ─────────────────────────────
AI_PROVIDER=stub

# ── Google Maps (server-side geocoding) ──────────────────────────────────────
GOOGLE_MAPS_SERVER_KEY=your_server_key_here

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Push Notifications (Web Push / VAPID) ────────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@yourdomain.com
