{
  "name": "stayonmap-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "start:prod": "pm2 start ecosystem.config.cjs --env production",
    "lint": "eslint src",
    "build": "cd ../frontend && npm install && npm run build && cp -r dist ../backend/public",
    "metro": "node scripts/metro-engine.mjs",
    "seed:test": "node scripts/seed-test-accounts.mjs",
    "seed:test:clean": "node scripts/cleanup-test-accounts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@sentry/node": "^10.67.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.110.8",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "expo-server-sdk": "^6.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "geotiff": "^3.0.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.2",
    "rate-limit-redis": "^5.0.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "nodemon": "^3.1.3",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "find-my-way": "^9.7.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
