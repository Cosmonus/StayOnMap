{
  "name": "stayonmap-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "start:prod": "pm2 start ecosystem.config.cjs --env production",
    "lint": "eslint src",
    "build": "cd ../frontend && npm install && npm run build && cp -r dist ../backend/public",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@prisma/client": "^5.15.0",
    "@sentry/node": "^10.65.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.43.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "rate-limit-redis": "^4.3.1",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "nodemon": "^3.1.3",
    "prisma": "^5.15.0",
    "supertest": "^7.2.2",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
