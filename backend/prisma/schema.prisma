generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────

enum UserRole {
  TENANT
  OWNER
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  PG
  INDEPENDENT_HOUSE
  COMMERCIAL
  LAND
  SHORT_STAY
}

// How a listing is priced. RENT is the normal monthly-rent deal. LEASE is the
// Kerala/Karnataka arrangement: the tenant hands over a lump sum, pays no
// monthly rent, and the owner returns the principal when they leave.
//
// `Property.rent` holds the primary price in BOTH modes — the lease sum for
// LEASE, the monthly rent for RENT — the same way SHORT_STAY mirrors its
// nightlyRate into `rent`. Read `rent` through pricingModel, never as "/mo".
enum PricingModel {
  RENT
  LEASE
  SALE
}

enum FurnishedType {
  FULLY
  SEMI
  UNFURNISHED
}

enum PropertyStatus {
  DRAFT
  PENDING
  ACTIVE
  INACTIVE
  OCCUPIED
  SUSPENDED
  REJECTED
}

enum AppointmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  // The OWNER moved the visit. Carries `scheduledAt` + `ownerNote`.
  RESCHEDULED
  // The RENTER proposed a different time. Carries the renter's own
  // `requestedDate`/`requestedTime` + `tenantNote`, and never touches the
  // owner's two fields — a counter-offer must not be able to put words in the
  // owner's mouth on the owner's own card. Added 2026-08-07; before it, a
  // renter who could not make the slot could only cancel and start again.
  RESCHEDULE_REQUESTED
  CANCELLED
}

enum GenderPreference {
  ANY
  MALE
  FEMALE
}

enum ReviewerType {
  TENANT
  PREVIOUS_TENANT
  NEIGHBOR
  COMMUNITY
}

enum ContentStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum InsightCategory {
  WATER_SHORTAGE
  SAFETY_CONCERN
  QUIET_AREA
  FAMILY_FRIENDLY
  STUDENT_FRIENDLY
  TRAFFIC
  TRANSPORT
  NOISE
  OTHER
}

enum ReportCategory {
  FRAUD
  FAKE_PHOTOS
  UNAUTHORIZED_LISTING
  WRONG_PRICING
  UNSAFE
  ILLEGAL
  HARASSMENT
  OWNER_MISCONDUCT
  DUPLICATE
  FALSE_INFO
  NOISE
  WATER
  SECURITY
  BROKER_SPAM
  OTHER
}

enum ReportSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum VerificationDocType {
  GOVT_ID
  PROPERTY_TAX
  UTILITY_BILL
  RENTAL_AGREEMENT
  AADHAAR
  PAN
  SELFIE
  OTHER
  GST
  TRADE_LICENSE
  PATTA_TITLE
  HOMESTAY_PERMIT
}

enum FraudSignalType {
  DUPLICATE_ADDRESS
  SIMILAR_GEOLOCATION
  REUSED_IMAGES
  SAME_CONTACT
  SIMILAR_DESCRIPTION
  AI_FLAGGED
}

enum TrustBadge {
  VERIFIED_OWNER
  COMMUNITY_TRUSTED
  HIGHLY_RECOMMENDED
  VERIFIED_NEIGHBORHOOD
  LOW_COMPLAINT
  UNDER_REVIEW
  SUSPICIOUS
  NEEDS_ATTENTION
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  SUSPICIOUS
}

enum FacingDirection {
  EAST
  WEST
  NORTH
  SOUTH
}

enum ModerationActionType {
  APPROVE
  REJECT
  SUSPEND
  INVESTIGATE
  DISMISS
  WARN_OWNER
}

enum ListingVisibility {
  PUBLIC // visible to everyone including non-logged-in visitors
  LOGGED_IN // pins show but details require login
  HIDDEN // not shown on map at all
}

enum ContactVisibility {
  EVERYONE // any logged-in user can see contact details
  LOGGED_IN // same as EVERYONE (alias kept for future distinction)
  NOBODY // contact info hidden from all users
}

// The hat a notification is addressed to — see Notification.audience.
enum NotificationAudience {
  TENANT
  OWNER
}

enum NotificationType {
  APPOINTMENT_REQUEST
  APPOINTMENT_STATUS
  APPOINTMENT_ACCEPTED
  APPOINTMENT_REJECTED
  REPORT_SUBMITTED
  REPORT_UPDATE
  VERIFICATION_UPDATE
  TRUST_ALERT
  LEASE_OFFERED
  LEASE_SIGNED
  LEASE_REJECTED
  SYSTEM
  MESSAGE
}

enum LeaseStatus {
  OFFERED
  ACTIVE
  REJECTED
  TERMINATED
  EXPIRED
}

// ─────────────────────────────────────────────────────────────────
// Admin (separate auth — not Supabase)
// ─────────────────────────────────────────────────────────────────

model Admin {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String

  moderationActions ModerationAction[]
  activityLogs      ActivityLog[]

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────
// User (custom JWT auth — not Supabase)
// ─────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  passwordHash    String? // null = social-login-only account (no password set yet)
  displayId       String?   @unique // Human-readable ID: SRI-1234567890123456
  email           String    @unique
  name            String
  phone           String?
  // Set only by the SMS code flow (features/auth/phone.service.js). NULL is the
  // honest state for every number that was merely typed in — which is all of
  // them before this shipped. Cleared whenever `phone` changes, or a verified
  // badge would outlive the number that earned it.
  phoneVerifiedAt DateTime?
  city            String? // self-reported at signup — one of config/cities.js's SUPPORTED_CITIES (users outside these go to WaitlistEntry instead of getting an account)
  avatarUrl       String?
  bio             String?
  socialLinks     Json? // { website, linkedin, instagram, twitter }
  role            UserRole  @default(TENANT)
  isVerified      Boolean   @default(false)
  isBlocked       Boolean   @default(false)
  isBusiness      Boolean   @default(false) // gates creating PG / COMMERCIAL / SHORT_STAY listings
  businessSince   DateTime?

  // Settings
  listingVisibility ListingVisibility @default(PUBLIC)
  contactVisibility ContactVisibility @default(LOGGED_IN)
  showExactLocation Boolean           @default(true)
  emailNotifs       Boolean           @default(true)
  pushNotifs        Boolean           @default(true)

  properties         Property[]
  occupiedProperties Property[]            @relation("CurrentTenant")
  savedListings      SavedListing[]
  appointments       Appointment[]         @relation("TenantAppointments")
  reviews            CommunityReview[]
  votes              RecommendationVote[]
  insights           NeighborhoodInsight[]
  reports            PropertyReport[]
  notifications      Notification[]
  activityLogs       ActivityLog[]

  tenantConversations Conversation[] @relation("TenantConversations")
  ownerConversations  Conversation[] @relation("OwnerConversations")
  sentMessages        Message[]      @relation("SentMessages")

  tenantLeases        Lease[]              @relation("TenantLeases")
  ownerLeases         Lease[]              @relation("OwnerLeases")
  pushSubscriptions   PushSubscription[]
  expoPushTokens      ExpoPushToken[]
  ownerTrustScore     OwnerTrustScore?
  passwordResetTokens PasswordResetToken[]
  emailOtps           EmailOtp[]
  phoneOtps           PhoneOtp[]
  analyticsEvents     AnalyticsEvent[]
  pointsLedger        PointsLedger[]
  socialAccounts      SocialAccount[]
  authSessions        AuthSession[]
  listingDraft        ListingDraft?

  // Blocks and reports the user MADE, and the ones aimed AT them. Both sides
  // are needed: "who have I blocked" powers the settings list, "who has blocked
  // me" is what the message gate actually reads.
  blocksMade      UserBlock[]  @relation("BlocksMade")
  blocksReceived  UserBlock[]  @relation("BlocksReceived")
  reportsMade     UserReport[] @relation("UserReportsMade")
  reportsReceived UserReport[] @relation("UserReportsAgainst")

  lastLoginAt DateTime?
  // When they last opened their saved list. Powers "since you last looked" —
  // which has to mean something, so it is measured rather than approximated with
  // "in the last week".
  savedSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────
// Social login (OAuth) + refresh-token sessions
// ─────────────────────────────────────────────────────────────────

enum AuthProvider {
  GOOGLE
  FACEBOOK
  LINKEDIN
  TWITTER
}

// One row per linked provider identity. Several providers can point at ONE
// User — that is the whole point (no duplicate accounts). Provider access/
// refresh tokens are deliberately NOT stored: we never call a provider's API
// after login, so keeping their credentials would be pure liability.
model SocialAccount {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String // the provider's stable subject id, never the email
  providerEmail  String?
  avatarUrl      String?
  linkedAt       DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider]) // one Google per account, not several
}

// One row per logged-in device. Holds the CURRENT refresh token (sha256 only —
// the raw token exists only on the client) plus the immediately-previous one:
// presenting a rotated-out token is how a stolen-then-replayed refresh token
// reveals itself, and the response is to revoke the whole session.
model AuthSession {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  prevTokenHash String?   @unique
  userAgent     String?
  deviceLabel   String? // "Chrome on Windows" — parsed once at login, not per read
  ip            String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────
// Canonical places — entity resolution across POI datasets
// ─────────────────────────────────────────────────────────────────

// One row per REAL-WORLD place; PlaceSource holds each dataset's record of
// it. Exists because the Overture bake-off (docs/overture-bakeoff-2026-07-20)
// measured 10-64% mutual overlap with PoiIndex — two sources describing
// overlapping-but-different realities, which is the condition
// proximityIndex.js set for building this. PoiIndex remains the SERVING
// table; Place is the conflation layer new sources merge into, and where the
// future consistency factor gets its measured disagreement from.
// Deliberately NO PlaceRelation table yet: CellPoiSummary already serves the
// proximity filter, and columns are promoted when a consumer needs them.
model Place {
  id        String   @id @default(cuid())
  name      String?
  category  String // poiCategories.js vocabulary
  lat       Decimal  @db.Decimal(10, 7)
  lng       Decimal  @db.Decimal(10, 7)
  city      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sources PlaceSource[]

  @@index([city, category])
  @@index([category, lat, lng]) // bbox prefilter, same pattern as PoiIndex
}

model PlaceSource {
  id         String   @id @default(cuid())
  placeId    String
  source     String // 'osm' | 'overture' | a government list later
  sourceKey  String // the source's own stable id (osmId, Overture GERS id)
  name       String? // as THIS source spells it — the consistency factor's raw material
  lat        Decimal? @db.Decimal(10, 7)
  lng        Decimal? @db.Decimal(10, 7)
  category   String?
  confidence Decimal? @db.Decimal(4, 3) // source-asserted (Overture); null for OSM
  ingestedAt DateTime @default(now())

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([source, sourceKey])
  @@index([placeId])
}

// ─────────────────────────────────────────────────────────────────
// Password Reset Tokens
// ─────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Passwordless login: a 6-digit code emailed to a registered address.
// Only ever stored hashed (sha256) — same rule as PasswordResetToken, so a
// DB read can never yield a usable code. Not @unique like tokenHash: 6 digits
// collide across users by design, so lookup is scoped by userId.
//
// `attempts` caps guessing at MAX_OTP_ATTEMPTS: 6 digits is only 1e6 combos,
// which is brute-forceable within the TTL without a counter.
// What a user can earn points for. Every action here is something that makes
// the platform more useful to the NEXT renter — that is the whole design rule.
// Nothing rewards mere activity (logging in, browsing, streaks): a person
// hunting for a home is not a daily-habit user, and paying them to come back
// would be a dark pattern, not help.
enum PointsAction {
  EMAIL_VERIFIED // proved the inbox (registration link or OTP login)
  PHONE_VERIFIED // reachable owner/tenant contact
  PROFILE_COMPLETED // name + avatar + city + phone
  REVIEW_APPROVED // a review that PASSED moderation — never on submit
  INSIGHT_ADDED // a neighbourhood insight
  REPORT_UPHELD // a report a moderator RESOLVED — never on submit
  LEASE_SIGNED // completed a tenancy through the platform
}

// Append-only points ledger. A ledger, not a counter on User, because:
//   1. every award is auditable — "why do I have 420 points?" is answerable
//   2. the unique constraint below makes awarding idempotent
//   3. a moderator reversing a decision can delete one row, not guess a delta
//
// The unique (userId, action, referenceId) is the anti-farming mechanism, and
// it is load-bearing: without it, re-running any trigger (a review re-approved,
// a report re-resolved) silently pays out again. `referenceId` is NON-NULL with
// an '' default on purpose — Postgres treats NULLs as distinct, so a nullable
// column would let one-time actions (EMAIL_VERIFIED) be awarded unboundedly.
// '' means "once per user, ever".
model PointsLedger {
  id          String       @id @default(cuid())
  userId      String
  action      PointsAction
  points      Int
  referenceId String       @default("") // Review/Report/Lease id — '' = once per user
  createdAt   DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action, referenceId])
  @@index([userId])
}

model EmailOtp {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Product telemetry — first-party, in our own database.
//
// No vendor: PostHog/Plausible/GA would each be a new processor in /privacy,
// would send our users' behaviour to someone else, and would need a cookie
// story the policy currently does not have ("we do not use third-party
// advertising trackers or analytics cookies"). We already run Postgres. Same
// reasoning as self-hosting the OSM POIs rather than paying Google per call.
//
// `sessionId` is client-generated, random, and lives for one session — it
// stitches a funnel together without identifying anybody. `userId` is the only
// personal link here, which is why it is a real relation with **SetNull**:
// deleting an account must remove the link (DPDP, and /privacy promises it)
// without deleting the aggregate history, which would silently rewrite past
// funnel numbers. `propertyId` is a plain string on purpose — a listing id is
// not personal data, and a FK on a high-write table costs more than it buys.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  name       String // constrained to features/analytics/events.js, not free text
  sessionId  String
  userId     String?
  propertyId String?
  city       String?
  props      Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // The funnel query's access path: count by step within a window.
  @@index([name, createdAt])
  // Stitching one session's steps together, and the retention prune.
  @@index([sessionId])
  @@index([createdAt])
}

// SMS codes proving control of a phone number. Shaped like EmailOtp, with one
// column that changes the security properties: `phone`. A code is issued FOR a
// specific number, so changing the number mid-flow cannot be verified by the
// code already in transit — and the per-destination daily cap (which EmailOtp
// needs no equivalent of, since it only ever mails a registered address) is
// what stops this endpoint being used to text-bomb a number the sender does
// not own.
model PhoneOtp {
  id         String    @id @default(cuid())
  userId     String
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // The per-destination throttle's access path: count sends to THIS number
  // since a cutoff, regardless of which account asked.
  @@index([phone, createdAt])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────
// Waitlist — signups from cities outside SUPPORTED_CITIES (config/cities.js)
// get captured here instead of a real User account. Not a User relation —
// these people never had an account to begin with.
// ─────────────────────────────────────────────────────────────────

model WaitlistEntry {
  id        String   @id @default(cuid())
  name      String
  email     String
  city      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────
// Push Subscriptions
// ─────────────────────────────────────────────────────────────────

model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  endpoint String @unique
  p256dh   String
  auth     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

// Expo push tokens — mobile app (iOS/Android via Expo's push service), kept
// separate from PushSubscription (browser Web Push, VAPID-keyed) since the
// two delivery mechanisms use unrelated credential shapes.
model ExpoPushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────
// Amenities (normalized, admin-managed)
// ─────────────────────────────────────────────────────────────────

model Amenity {
  id   String @id @default(cuid())
  name String @unique

  properties PropertyAmenity[]
}

// ─────────────────────────────────────────────────────────────────
// Property
// ─────────────────────────────────────────────────────────────────

model Property {
  id          String         @id @default(cuid())
  displayId   String?        @unique // Human-readable ID: APT-1234567890123456
  title       String
  description String
  type        PropertyType
  furnished   FurnishedType  @default(UNFURNISHED)
  status      PropertyStatus @default(DRAFT)

  // Location
  address  String
  city     String
  state    String
  pincode  String
  landmark String?
  lat      Decimal @db.Decimal(10, 7)
  lng      Decimal @db.Decimal(10, 7)

  // Specifics
  bhk             Int?
  sharing         Int? // for PG type: 1–6
  area            Decimal?         @db.Decimal(10, 2) // sq.ft
  totalFloors     Int?
  floor           Int? // which floor the unit is on
  facingDirection FacingDirection?
  bathrooms       Int? // apartment / house / short_stay

  // HOUSE — which of the 4 describe-step choices (Independent house/Villa/Duplex/Row
  // house); `type` is derived from this (VILLA/INDEPENDENT_HOUSE get their own enum
  // value, Duplex/Row house both map to HOUSE, distinguished only by this field)
  houseStyle String?

  // LAND
  landType       String? // Residential | Agricultural | Commercial | Industrial
  extent         Decimal? @db.Decimal(10, 2)
  extentUnit     String? // sq.ft | acres | cents etc.
  dimensions     String? // free text, e.g. "40 x 60 ft"
  roadWidth      Decimal? @db.Decimal(10, 2) // ft
  approvalStatus String? // DTCP | RERA | Panchayat | Unapproved
  // Superseded by pricingModel SALE/LEASE (2026-07-26) and backfilled from it.
  // Kept because it is a live public filter and released mobile builds send it.
  saleOrLease    String? // SALE | LEASE — land can be either

  // LAND RECORDS — how the STATE identifies this piece of land. Added
  // 2026-07-26; before this a plot listing carried no identifier that could be
  // checked against any government record, which is the first thing a buyer's
  // lawyer asks for.
  //
  // ⚠ surveyNumber / subdivisionNumber / landRecordNumber are NEVER returned on
  // a public property response (properties.service.js strips them for anyone
  // but the owner and admin). They are semi-public records, but a survey number
  // next to an owner's name on an open listing page is a land-fraud kit, and no
  // Indian portal publishes them. They exist for verification, not for display.
  //
  // `landRecordType` is state-specific because the record genuinely is: patta/
  // chitta in Tamil Nadu, A-khata/B-khata in Karnataka (where B-khata means no
  // bank loan — a buyer warning, not a formality), 7/12 extract in Maharashtra
  // and Gujarat, pahani/ROR in Telangana, porcha in West Bengal, and
  // freehold/leasehold/GPA in Delhi. One field labelled "Patta number" would be
  // wrong in five of the six states we operate in.
  surveyNumber      String?
  subdivisionNumber String?
  landRecordType    String? // the state's record kind, see config/landRecords.js
  landRecordNumber  String?
  conversionStatus  String? // Converted | Not converted | Not applicable
  ecAvailable       Boolean? // encumbrance certificate on hand
  ecYears           Int? // how many years it covers (13 and 30 are the norms)
  guidelineValue    Decimal? @db.Decimal(12, 2) // government circle/guideline rate

  // COMMERCIAL (shop/office/showroom/warehouse)
  commercialType String? // Retail shop | Office | Showroom | Warehouse
  carpetArea     Decimal? @db.Decimal(10, 2)
  frontage       Decimal? @db.Decimal(10, 2) // ft
  powerLoad      String? // sanctioned power load, e.g. "15 kW"

  // PG
  totalBeds        Int?
  availableBeds    Int?
  noticePeriodDays Int?

  // SHORT_STAY
  placeType   String? // Entire place | Private room | Shared room
  maxGuests   Int?
  beds        Int? // distinct from bhk/bedrooms — total sleeping beds
  nightlyRate Decimal? @db.Decimal(10, 2)
  cleaningFee Decimal? @db.Decimal(10, 2)
  weekendRate Decimal? @db.Decimal(10, 2)
  minNights   Int?
  maxNights   Int?
  instantBook Boolean?

  // Pricing
  // pricingModel decides how `rent` reads — it is the primary price in all
  // three modes and never means one thing by default:
  //   RENT  monthly rent
  //   LEASE the refundable lump sum (deposit is 0 — the sum IS the money at stake)
  //   SALE  the asking price, with `deposit` holding the booking advance
  // Which modes a type may use is enforced in properties.validation.js, not by
  // the DB: LEASE and SALE are flats/houses/shops (+ land for SALE); a PG bed
  // and a nightly stay can be neither leased nor sold.
  pricingModel       PricingModel @default(RENT)
  // Decimal(12,2) since 2026-07-26, not (10,2): a ₹10Cr asking price does not
  // fit in eight digits, and a Mumbai flat reaching that is ordinary. Every
  // money column an asking price can flow through was widened together.
  rent               Decimal      @db.Decimal(12, 2)
  deposit            Decimal      @db.Decimal(12, 2)
  maintenance        Decimal?     @db.Decimal(10, 2)
  brokerage          Decimal?     @db.Decimal(10, 2)
  electricityCharges Decimal?     @db.Decimal(10, 2)
  waterCharges       Decimal?     @db.Decimal(10, 2)

  // SALE (pricingModel = SALE). The three questions a buyer asks that a rent
  // listing has no equivalent for. `availableFrom` doubles as the possession
  // date, which is why possessionStatus sits beside it: "1 March" means
  // something completely different on a ready flat and an under-construction one.
  possessionStatus String? // Ready to move | Under construction | New launch
  priceNegotiable  Boolean?
  loanEligible     Boolean? // a bank will lend against it (B-khata land often not)

  // Availability
  availableFrom  DateTime?
  occupancyLimit Int?
  leaseDuration  Int? // months

  // Appointment window set by owner (e.g. "09:00" / "18:00")
  appointmentWindowStart String?
  appointmentWindowEnd   String?

  // Owner
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  // Current tenant (set when status = OCCUPIED)
  currentTenant   User?     @relation("CurrentTenant", fields: [currentTenantId], references: [id], onDelete: SetNull)
  currentTenantId String?
  occupiedSince   DateTime?

  // When a renter could FIRST see this — not when the row was made. A listing
  // is drafted, submitted, and only goes ACTIVE on approval, so `createdAt`
  // answers a different question. Written once and never from a vacancy; the
  // rule lives in features/properties/publishedAt.js. NULL means "live before
  // 2026-08-10", which is honest — it is deliberately not backfilled, because
  // `updatedAt` has moved for every edit and score recalculation since.
  publishedAt     DateTime?

  // Relations
  images             PropertyImage[]
  amenities          PropertyAmenity[]
  rules              PropertyRule?
  appointments       Appointment[]
  savedBy            SavedListing[]
  reviews            CommunityReview[]
  votes              RecommendationVote[]
  insights           NeighborhoodInsight[]
  reports            PropertyReport[]
  verification       OwnershipVerification?
  trustScore         TrustScore?
  riskScore          PropertyRiskScore?
  fraudSignals       FraudSignal[]
  conversations      Conversation[]
  leases             Lease[]
  availabilityBlocks AvailabilityBlock[]
  priceHistory       PropertyPriceHistory[]
  dailyViews         PropertyDailyView[]
  viewers            PropertyViewer[]
  // The SIMILAR_TO edge, both ends. Stored directed so "top 12 like this one"
  // is one indexed read; computed for both directions so the edge is navigable
  // from either listing.
  similarTo          PropertySimilarity[]   @relation("SimilarFrom")
  similarFrom        PropertySimilarity[]   @relation("SimilarTo")

  // The geohash-7 cell this listing sits in (~153m), derived from lat/lng.
  // Denormalised on purpose: it is the join key between a property and the
  // spatial layer's per-cell data, and a filter cannot join on a value it has
  // to compute per row. Nullable because it is derived — a row whose
  // coordinates predate this column, or whose write path missed it, must read
  // as "unknown cell" rather than silently matching the wrong one.
  geohash String?

  // The resolved area this listing sits in. Nullable and resolved
  // fire-and-forget after write (like the spatial cell warm below it), so a
  // create is never blocked on a polygon lookup and a listing whose point falls
  // outside every mapped boundary simply stays unresolved rather than being
  // forced into the wrong area. Readers fall back to `landmark`.
  locality   Locality? @relation(fields: [localityId], references: [id], onDelete: SetNull)
  localityId String?

  // What the owner's listing page needs to say something true about reach.
  // Counts a detail-page view by anyone who is NOT the owner — an owner
  // refreshing their own listing is not interest, and a number that inflates
  // when you look at it is worse than no number.
  viewCount Int @default(0)

  // When the owner sent it for review (DRAFT → PENDING). Distinct from
  // updatedAt, which any later edit moves: "Submitted 4 hours ago" has to mean
  // submitted, not touched.
  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([status])
  @@index([lat, lng])
  @@index([ownerId])
  @@index([type])
  @@index([pricingModel])
  @@index([geohash])
  @@index([localityId])
  // The supply trend groups by week over this and filters out nulls.
  @@index([publishedAt])
  // Buyers filter on these three the way renters filter on rent.
  //
  // DECLARED HERE 2026-08-07, though they have existed in the database since
  // migration 20260726010000 created them in raw SQL. Undeclared, they were
  // invisible to Prisma: `migrate diff` reported them as drift, and the next
  // `migrate dev` or `db push` would have generated a migration DROPPING all
  // three — silently removing production indexes nobody asked to remove.
  //
  // This is the identical trap SpatialContext_geohash_prefix_idx documents and
  // was fixed for; it was still open on these three. Adding the declarations
  // needs no migration — the indexes are already there, on every database that
  // ran 20260726010000, which is all of them.
  @@index([possessionStatus])
  @@index([loanEligible])
  @@index([conversionStatus])
}

// Views per day, per listing. Property.viewCount is a lifetime total and so
// cannot answer a windowed question — "412 views in the last 30 days" needs
// history, and this is the cheapest shape that has it: one row per listing per
// day, upserted on each counted view.
//
// Not one row per view event: a listing with real traffic would generate
// millions of rows to answer a question that only ever needs daily totals.
model PropertyDailyView {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  day        DateTime @db.Date
  count      Int      @default(0)

  @@unique([propertyId, day])
  @@index([day])
}

// How many times one identified person has viewed one listing.
//
// Shown to the owner in exactly ONE place: beside a visit request from that
// same person ("she has viewed it 4 times"), where they have already
// identified themselves to the owner by asking to come round. It is never
// exposed as a general "who looked at my listing" feed — that would be
// surveillance of people who only browsed, and there is no endpoint for it.
//
// Anonymous views are not attributable and are counted only in the totals above.
model PropertyViewer {
  id           String   @id @default(cuid())
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId   String
  userId       String
  count        Int      @default(1)
  lastViewedAt DateTime @default(now())

  @@unique([propertyId, userId])
  @@index([userId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  url        String
  isPrimary  Boolean  @default(false)
  order      Int      @default(0)

  @@index([propertyId])
}

model PropertyAmenity {
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  amenityId  String

  @@id([propertyId, amenityId])
}

model PropertyRule {
  id                String           @id @default(cuid())
  property          Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId        String           @unique
  smokingAllowed    Boolean          @default(false)
  petsAllowed       Boolean          @default(false)
  bachelorAllowed   Boolean          @default(true)
  familyPreferred   Boolean          @default(false)
  visitorsAllowed   Boolean          @default(true)
  nonVegAllowed     Boolean          @default(false)
  curfewTime        String?
  genderPreference  GenderPreference @default(ANY)
  foodPreference    String?
  alcoholAllowed    Boolean          @default(false)
  noiseRestrictions String?
}

// ─────────────────────────────────────────────────────────────────
// Saved Listings (Favorites)
// ─────────────────────────────────────────────────────────────────

model SavedListing {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  // The asking price the moment they saved it, so the saved list can say
  // "₹2,000 cheaper than when you saved" — the one thing that makes a saved
  // list worth returning to rather than a folder of links.
  //
  // Stored here rather than derived from PropertyPriceHistory: nothing writes to
  // that table yet, and even once something does it could not answer this for
  // saves made before it started. Null on rows saved before 2026-07-26, which
  // renders as no claim at all.
  rentAtSave Decimal? @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
}

// The add-listing wizard's unfinished draft, so it follows the PERSON rather
// than the device they started on. An owner photographs a flat on their phone
// and finishes the pricing on a laptop; before this the two clients wrote the
// same envelope, under the same key name, to two stores that never met.
//
// NOT the same thing as a Property with status DRAFT. That is a real listing
// row that exists on the server and was never submitted for review; this is
// client scratch state for a listing that has no row yet — the wizard calls
// create+publish back to back at the very end, so a wizard in progress has no
// server footprint at all. That is precisely why this table has to exist.
//
// `payload` is the client envelope verbatim ({ categoryKey, stepIdx, stepKey,
// draft }) rather than columns: it is a half-answered form whose shape changes
// every time the wizard gains a question, it is only ever read whole, and
// nothing filters on it. Promote a value out of here when a QUERY needs it —
// the same rule SpatialContext.modules follows.
model ListingDraft {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // One slot per owner, matching what both wizards already assume — "start
  // fresh" discards the saved one on both platforms, and a unique constraint
  // is what makes the upsert safe against two devices pushing at once.
  userId String @unique

  payload Json

  // The CLIENT's own timestamp, not the server's, because it is the clock both
  // wizards already stamp their local envelope with — and the pull compares
  // this against that local value to decide who wins. Last write wins on wall
  // clock: two devices editing the same draft at the same moment means the
  // later stamp survives and the other's edits are lost. That is a real limit,
  // accepted because this is one person with one draft slot, not a shared
  // document. Kept separate from updatedAt so a same-payload re-push can't
  // fake progress.
  savedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────
// Appointments
// ─────────────────────────────────────────────────────────────────

model Appointment {
  id            String            @id @default(cuid())
  property      Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId    String
  tenant        User              @relation("TenantAppointments", fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId      String
  ownerId       String
  requestedDate DateTime
  requestedTime String
  message       String?
  contactNumber String
  status        AppointmentStatus @default(PENDING)
  scheduledAt   DateTime?
  ownerNote     String?
  // When the OWNER first answered — accepted, declined or moved it. Written
  // once and never overwritten, so a later edit cannot rewrite how fast they
  // replied. This is why it is not `updatedAt`: that moves on every subsequent
  // change, and an owner who replied in ten minutes then added a note a week
  // later would measure as a week. NULL means either "still waiting" or "row
  // predates 2026-08-07" — features/trust/responsiveness.js tells the two
  // apart by status and never invents a duration for the old ones.
  respondedAt   DateTime?
  // The renter's voice, mirroring ownerNote. Written only by the renter, only
  // on RESCHEDULE_REQUESTED.
  tenantNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, propertyId, status])
  @@index([propertyId])
  @@index([tenantId])
  @@index([ownerId])
}

// ─────────────────────────────────────────────────────────────────
// Community Reviews & Ratings
// ─────────────────────────────────────────────────────────────────

model CommunityReview {
  id           String       @id @default(cuid())
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId   String
  reviewer     User         @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewerType ReviewerType
  isAnonymous  Boolean      @default(false)
  isVerified   Boolean      @default(false)
  recommend    Boolean

  // 12-category ratings (1–5)
  ratingsSafety        Int
  ratingsClean         Int
  ratingsWater         Int
  ratingsNoise         Int
  ratingsInternet      Int
  ratingsParking       Int
  ratingsNeighborhood  Int
  ratingsTransport     Int
  ratingsMaintenance   Int
  ratingsOwnerBehavior Int
  ratingsSecurity      Int
  ratingsPowerBackup   Int

  body          String
  mediaUrls     String[]
  status        ContentStatus @default(PENDING)
  ownerResponse String?

  createdAt DateTime @default(now())

  @@unique([reviewerId, propertyId])
  @@index([propertyId])
  @@index([status])
}

model RecommendationVote {
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  recommend  Boolean

  @@id([propertyId, userId])
}

model NeighborhoodInsight {
  id          String          @id @default(cuid())
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId  String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  isAnonymous Boolean         @default(false)
  category    InsightCategory
  body        String

  createdAt DateTime @default(now())

  @@index([propertyId])
}

// ─────────────────────────────────────────────────────────────────
// Property Reports
// ─────────────────────────────────────────────────────────────────

model PropertyReport {
  id            String         @id @default(cuid())
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId    String
  reporter      User?          @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reporterId    String?
  isAnonymous   Boolean        @default(false)
  category      ReportCategory
  description   String
  severity      ReportSeverity
  evidenceUrls  String[]
  status        ReportStatus   @default(PENDING)
  ownerResponse String?

  moderationAction ModerationAction?

  createdAt DateTime @default(now())

  @@index([propertyId])
  @@index([status])
  @@index([severity])
}

// ─────────────────────────────────────────────────────────────────
// Ownership Verification
// ─────────────────────────────────────────────────────────────────

model OwnershipVerification {
  id         String             @id @default(cuid())
  property   Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String             @unique
  ownerId    String
  status     VerificationStatus @default(PENDING)
  adminNote  String?
  reviewedAt DateTime?
  reviewedBy String? // Admin.id

  // The property address AS PRINTED on the ownership document, declared by the
  // owner at submission. This is what lets the listing address be checked
  // against the document without any machine ever reading the document itself
  // — OCR on Aadhaar/PAN-bearing images via an external API is a privacy
  // decision the ops docs reserve for a lawyer, and AI is stubbed in prod
  // anyway. A declaration is still a claim, but it is a claim made in writing
  // against a document the admin will open: an honest owner catches their own
  // typo at submit time, and a false declaration becomes a documented lie.
  documentAddress String?

  documents VerificationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ownerId])
}

model VerificationDocument {
  id             String                @id @default(cuid())
  verification   OwnershipVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  verificationId String
  type           VerificationDocType
  url            String
  uploadedAt     DateTime              @default(now())

  @@index([verificationId])
}

// ─────────────────────────────────────────────────────────────────
// Trust & Risk Scores
// ─────────────────────────────────────────────────────────────────

model TrustScore {
  id                String      @id @default(cuid())
  property          Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId        String      @unique
  overallScore      Float       @default(0)
  safetyScore       Float       @default(0)
  cleanlinessScore  Float       @default(0)
  neighborhoodScore Float       @default(0)
  totalReviews      Int         @default(0)
  recommendCount    Int         @default(0)
  notRecommendCount Int         @default(0)
  recommendPercent  Float       @default(0)
  badge             TrustBadge?
  // Named scores
  areaScore         Float       @default(0) // AreaScore  0–10
  waterScore        Float       @default(0) // WaterScore 0–10
  // No floodSafeRating — dropped 2026-07-30, deliberately. See the refusal
  // note in features/trust/trust.service.js before adding anything like it.
  updatedAt         DateTime    @updatedAt
}

model OwnerTrustScore {
  id                String   @id @default(cuid())
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId           String   @unique
  score             Float    @default(0) // 0–100
  level             String   @default("UNRATED") // UNRATED | LOW | MEDIUM | HIGH | EXCELLENT
  // % of visit requests the owner ANSWERED — accepted, declined or moved.
  // Was "% accepted" until 2026-08-07, which punished the honest decline and
  // was printed to renters as a response rate. See features/trust/responsiveness.js.
  responseRate      Float    @default(0)
  reviewAvg         Float    @default(0) // avg StayScore across listings
  verificationLevel Int      @default(0)
  updatedAt         DateTime @updatedAt
}

model PropertyRiskScore {
  id                  String    @id @default(cuid())
  property            Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId          String    @unique
  score               Float     @default(0)
  level               RiskLevel @default(LOW)
  complaintCount      Int       @default(0)
  unauthorizedReports Int       @default(0)
  duplicateSignals    Int       @default(0)
  verificationLevel   Int       @default(0) // 0=none, 1=docs uploaded, 2=under review, 4=verified
  updatedAt           DateTime  @updatedAt
}

model FraudSignal {
  id         String          @id @default(cuid())
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  type       FraudSignalType
  detail     String?
  detectedAt DateTime        @default(now())
  resolved   Boolean         @default(false)

  @@index([propertyId])
}

// ─────────────────────────────────────────────────────────────────
// Moderation
// ─────────────────────────────────────────────────────────────────

model ModerationAction {
  id        String               @id @default(cuid())
  report    PropertyReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId  String               @unique
  admin     Admin                @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId   String
  action    ModerationActionType
  note      String?
  createdAt DateTime             @default(now())
}

// ─────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────

model Notification {
  id            String           @id @default(cuid())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  type          NotificationType
  title         String
  body          String
  isRead        Boolean          @default(false)
  referenceId   String?
  referenceType String?

  // Which HAT this is addressed to. The same account is a tenant and an owner,
  // and the two are separate everywhere else in the product (inbox, nav,
  // appointments) — a lease offer you received and a visit request for your
  // flat are not one stream. Set by the caller of notifyUser(), never derived:
  // the type alone can't say (APPOINTMENT_STATUS goes to the tenant on a
  // reschedule and to the owner on a cancellation; MESSAGE goes to whichever
  // side of the thread didn't send it).
  //
  // NULLABLE on purpose. Rows written before this column existed have no
  // honest value, and defaulting them to either hat would hide real
  // notifications from the other one. NULL means "unclassified" and shows in
  // BOTH modes — the only behaviour that can't lose someone's notification.
  audience NotificationAudience?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([userId, audience])
}

// ─────────────────────────────────────────────────────────────────
// Chat / Messaging
// ─────────────────────────────────────────────────────────────────

model Conversation {
  id            String       @id @default(cuid())
  propertyId    String
  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        User         @relation("TenantConversations", fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId       String
  owner         User         @relation("OwnerConversations", fields: [ownerId], references: [id], onDelete: Cascade)
  messages      Message[]
  userReports   UserReport[]
  lastMessageAt DateTime     @default(now())
  createdAt     DateTime     @default(now())

  @@unique([propertyId, tenantId])
  @@index([tenantId])
  @@index([ownerId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  isRead         Boolean      @default(false)
  // Attachments were image-only until 2026-07-26. A PDF needs two more facts to
  // be usable: what to CALL it and what it IS. The storage path stays a UUID
  // (uploads.service.js) — this is the display name, sanitised, not the path.
  attachmentUrl  String?
  attachmentName String?
  attachmentMime String?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
}

// ─────────────────────────────────────────────────────────────────
// Activity Logs
// ─────────────────────────────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminId   String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────
// Lease
// ─────────────────────────────────────────────────────────────────

model Lease {
  id            String  @id @default(cuid())
  propertyId    String
  tenantId      String
  ownerId       String
  appointmentId String?

  startDate     DateTime
  endDate       DateTime
  rentAmount    Decimal     @db.Decimal(10, 2)
  depositAmount Decimal     @db.Decimal(10, 2)
  status        LeaseStatus @default(OFFERED)

  ownerNote    String?
  tenantNote   String?
  signedAt     DateTime?
  rejectedAt   DateTime?
  terminatedAt DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   User     @relation("TenantLeases", fields: [tenantId], references: [id], onDelete: Cascade)
  owner    User     @relation("OwnerLeases", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([ownerId])
  @@index([propertyId])
}

// ─────────────────────────────────────────────────────────────────
// Availability (SHORT_STAY calendars)
// ─────────────────────────────────────────────────────────────────

model AvailabilityBlock {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  date       DateTime @db.Date
  isBlocked  Boolean  @default(true)

  createdAt DateTime @default(now())

  @@unique([propertyId, date])
  @@index([propertyId])
}

// ─────────────────────────────────────────────────────────────────
// Spatial Intelligence (docs/spatial-intelligence.md)
// ─────────────────────────────────────────────────────────────────

// Neighbourhood facts belong to a place, not a listing — 400 flats in
// Koramangala share one set of metro stations. Keying by geohash-7 cell
// (~153m) means the second listing in a cell costs nothing to describe.
//
// Persisted in Postgres rather than only Redis for three reasons: the external
// Redis (Upstash) is evictable (losing it means re-billing Google for everything), a
// materialised table is a compounding asset that outlives any vendor, and the
// moment a filter needs "good walkability" the data has to be queryable.
// Redis stays in front as a short-TTL hot read cache.
model SpatialContext {
  id      String  @id @default(cuid())
  geohash String  @unique // precision 7, ~153m x 153m
  lat     Decimal @db.Decimal(10, 7) // cell centroid — facts are computed from here
  lng     Decimal @db.Decimal(10, 7)
  city    String?

  // { mobility: <envelope>, lifestyle: <envelope>, ... } — see
  // features/spatial/envelope.js for the shape. Json rather than columns
  // because envelopes evolve fast and are read whole; promote a value to a
  // real column the moment a filter needs it, and not before.
  modules Json

  computedAt DateTime @default(now())
  staleAfter DateTime
  // Consecutive materialisation failures. Circuit-breaks a cell that keeps
  // failing (bad coordinates, upstream outage) instead of retrying it forever
  // on a metered API.
  failCount  Int      @default(0)

  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([staleAfter])
  // Prefix scans (`geohash LIKE 'tdr1%'` — every cell in a coarser area) need a
  // text_pattern_ops operator class; the default btree on a non-C collation
  // cannot serve them. Declared here with an explicit `type` so Prisma OWNS it:
  // it was previously created only in raw SQL inside migration
  // 20260719000000, invisible to the schema, and the next `migrate dev` diff or
  // `db push` would have seen it as drift and dropped it — silently killing
  // every coarse-area query with no error anywhere.
  @@index([geohash(ops: raw("text_pattern_ops"))], map: "SpatialContext_geohash_prefix_idx", type: BTree)
}

// Rent/deposit over time, one row per observed change. The platform had no
// listing history at all — "has this price moved?" was unanswerable, which is
// both a fraud signal and something a renter legitimately wants to know.
model PropertyPriceHistory {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  rent       Decimal  @db.Decimal(10, 2)
  deposit    Decimal  @db.Decimal(10, 2)
  recordedAt DateTime @default(now())

  @@index([propertyId, recordedAt])
}

// ─────────────────────────────────────────────────────────────────
// Locality — the area a listing is IN, as an entity rather than a string
// ─────────────────────────────────────────────────────────────────

// A locality was `slugify(Property.landmark)` until 2026-08-07: owner-typed
// free text, re-derived on every request. That string is already load-bearing —
// it generates the public /rent/:city/:area landing pages — and as free text it
// cannot be a stable thing to attach anything to. "Koramangala", "Koramangala
// 5th Block" and "koramangala." were three localities, three landing pages, and
// three different answers to "how many listings are in Koramangala".
//
// Resolution order (features/localities/resolve.js):
//   1. OSM admin boundaries containing the listing's coordinates — ward (10),
//      zone (9) or municipality (8), most specific first. This is the honest
//      answer: it comes from the map, not from what the owner typed.
//   2. The owner's `landmark` text, when no boundary covers the point.
//      Ahmedabad and Surat genuinely have no ward/zone polygons in OSM, so
//      this is a permanent fallback, not a temporary one.
//
// Deliberately NOT a polygon of its own: Boundary already holds the geometry
// and `osmId` points at it. Duplicating the rings here would create two
// sources of truth for the same shape.
model Locality {
  id       String @id @default(cuid())
  city     String
  citySlug String
  name     String
  slug     String

  // 'BOUNDARY' — resolved from OSM admin polygons; `osmId` and `adminLevel` set.
  // 'LANDMARK' — derived from owner-typed text because no boundary covered the
  //              point. Kept distinct so a later boundary seed can upgrade these
  //              rather than silently leaving them looking authoritative.
  source     String
  osmId      String? @unique
  adminLevel Int?

  // Representative point — the first resolved listing's coordinates, not a
  // polygon centroid. Good enough to fly a map to; never used as a distance
  // anchor, which is what Property.geohash and the spatial layer are for.
  lat Decimal? @db.Decimal(10, 7)
  lng Decimal? @db.Decimal(10, 7)

  aliases    LocalityAlias[]
  properties Property[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The public URL's identity: /rent/:citySlug/:slug.
  @@unique([citySlug, slug])
  @@index([city])
}

// What owners actually call a locality.
//
// This is not decoration — it is the only reason resolving to a canonical name
// is safe. Collapsing "Koramangala 5th Block" into "Koramangala" would silently
// 404 the URL the first spelling had already published, so every alias keeps its
// own slug and getLocality() resolves through it to the canonical page.
model LocalityAlias {
  id         String   @id @default(cuid())
  locality   Locality @relation(fields: [localityId], references: [id], onDelete: Cascade)
  localityId String
  // As typed, trimmed. Kept verbatim because it is evidence of local usage.
  text       String
  slug       String
  // Denormalised from the parent so slug → locality is ONE indexed lookup on
  // the public route, not a join. It also makes the constraint below possible,
  // which is the load-bearing part: two localities in one city must never claim
  // the same alias slug, or /rent/chennai/<slug> has two right answers.
  citySlug   String

  createdAt DateTime @default(now())

  @@unique([citySlug, slug])
  @@index([localityId])
}

// ─────────────────────────────────────────────────────────────────
// SIMILAR_TO — the edge the platform had no way to express
// ─────────────────────────────────────────────────────────────────

// "Homes like this one", materialised top-k per listing.
//
// MATERIALISED, NOT COMPUTED PER REQUEST, for the same reason SpatialContext is:
// scoring one listing against every other is O(n) work that produces the same
// answer until one of them changes. A property page must not pay for it.
//
// WHY A SCORE AND NOT A DISTANCE. Similarity here is a blend — location, price,
// size, and the attributes that mean something for THAT property type — so the
// number is only meaningful relative to other rows for the same property, which
// is exactly how it is read (`order by score desc limit k`). It is never shown
// to a user as a percentage, because "87% similar" implies a precision this does
// not have.
//
// `reasons` carries the per-component breakdown that produced the score. It is
// what makes a recommendation explainable instead of an oracle, and it is the
// only way to debug a bad match without re-running the scorer by hand.
model PropertySimilarity {
  id String @id @default(cuid())

  property   Property @relation("SimilarFrom", fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  similar    Property @relation("SimilarTo", fields: [similarId], references: [id], onDelete: Cascade)
  similarId  String

  score   Float
  reasons Json?

  computedAt DateTime @default(now())

  // One edge per ordered pair; a recompute upserts rather than accumulating.
  @@unique([propertyId, similarId])
  // The only read this table serves: top-k for one listing.
  @@index([propertyId, score])
}

// ─────────────────────────────────────────────────────────────────
// Ranking weights — tunable without a deploy, never by the model
// ─────────────────────────────────────────────────────────────────

// The weights the ranking pipeline blends its component scores with.
//
// IN THE DATABASE because the brief they implement is explicit that they must be
// tunable from real behaviour, and a redeploy per experiment is how tuning stops
// happening. Code holds the defaults (features/graph/ranking.js), so an empty
// table is a working system rather than a broken one.
//
// NOT WRITABLE BY THE AGENT LAYER, and that is structural rather than a promise:
// nothing in features/graph/tools/ imports a writer for this table, and the only
// mutation path is an admin action. A model that can set its own weights can
// justify any ordering it likes after the fact.
model RankingWeights {
  id   String @id @default(cuid())
  name String @unique

  // { location, budget, commute, preference, trust, freshness } — normalised at
  // read time, so a profile that does not sum to 1 is scaled rather than
  // silently over-weighting everything.
  weights Json
  // Why this profile exists. An experiment nobody can explain is not a result.
  note    String?

  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────
// Search demand — what people asked for, and whether we had it
// ─────────────────────────────────────────────────────────────────

// The platform recorded what people DID (AnalyticsEvent's five funnel steps)
// and nothing about what they ASKED FOR. With inventory as the binding
// constraint, the unanswerable question was the important one: which area,
// budget and property type do people search for that we have nothing to show?
//
// AGGREGATE BY CONSTRUCTION — there is no sessionId, userId or IP here, and
// there is deliberately nowhere to put one. The question is "how much demand
// for what, where", which needs no person attached; and a table that cannot
// identify anyone cannot leak, cannot be subject-access-requested, and needs no
// consent conversation. Personalization inputs are a genuinely different thing
// and already exist per-user in SavedListing and PropertyViewer.
//
// One row per (day, query shape). Bounded by distinct shapes per day, not by
// traffic — a million searches for the same thing is one row with a counter.
model SearchDemand {
  id  String   @id @default(cuid())
  day DateTime @db.Date

  // Stable hash of every field below. The unique key with `day`; the columns
  // are carried alongside so the readout can group without re-parsing a hash.
  signature String

  // Geohash-5 (~4.9km) of the viewport centre — the AREA that was searched.
  // Coarse on purpose: it quantises panning, so nudging the map by a street
  // does not fork the row, and it is far too blunt to locate a person.
  cellGeohash String
  city        String?

  type         String?
  pricingModel String?
  bhk          Int?
  // A band, not the raw slider value: '10k-20k'. Raw values would fork a row
  // per drag tick and answer no question a band does not.
  rentBand     String?

  searches        Int  @default(0)
  // How many of those returned nothing. This is the column the whole table
  // exists for — it names the gap between what people want and what we list.
  zeroResults     Int  @default(0)
  // Most recent count, for eyeballing "is this thin or empty".
  lastResultCount Int?

  firstSeenAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([day, signature])
  // The readout: worst unmet demand in a window.
  @@index([day, zeroResults])
  @@index([cellGeohash, day])
}

// ─────────────────────────────────────────────────────────────────
// Image fingerprints — the raw material for reused-photo detection
// ─────────────────────────────────────────────────────────────────

// A 64-bit difference hash (dHash) of an uploaded image, keyed by its URL.
//
// Keyed by URL rather than added as a column on PropertyImage because the hash
// belongs to the BYTES, not to whichever listing currently references them. Two
// consequences that matter: an image uploaded, rejected and re-uploaded on a
// second account is still fingerprinted, which is exactly the pattern
// REUSED_IMAGES exists to catch; and the hash is computed at upload time from a
// buffer already in memory, so nothing is ever re-downloaded to compute it.
//
// dHash, not a cryptographic hash: it survives re-encoding, resizing and mild
// cropping, which is what a re-poster does. Comparison is Hamming distance in
// JS over a bounded candidate set — see features/intelligence/imageFingerprint.js
// for why that is enough at this scale and what would change it.
model ImageFingerprint {
  id         String  @id @default(cuid())
  url        String  @unique
  // 16 hex chars = 64 bits.
  hash       String
  // Who uploaded it. Not a foreign key: an upload can precede any listing, and
  // an account deletion must not erase the fingerprint of an image still in use
  // on a live listing.
  uploaderId String?

  createdAt DateTime @default(now())

  // Candidate narrowing is a full scan of this column today. See the service.
  @@index([hash])
  @@index([uploaderId])
}

// Self-hosted OpenStreetMap points of interest.
//
// This table exists to stop renting facts from Google. A Places Nearby call is
// metered per request, and the spatial layer needs ~9 of them per cell — with
// cell count driven by where owners list, not by us. The same question asked
// of a local table is a single indexed bbox scan.
//
// Seeded by scripts/fetch-osm-pois.mjs (a developer-machine operation, like
// scripts/seed-amenities.mjs — see docs/operator-actions.md). Empty in a fresh
// checkout, which is fine: the lifestyle module falls back to Google and says
// so in its confidence basis.
//
// No PostGIS: the composite (category, lat, lng) index turns a radius search
// into a bounding-box scan plus a haversine filter in JS, which is
// comfortably fast at a few hundred thousand rows. See
// docs/spatial-intelligence.md §3 for when that stops being true.
model PoiIndex {
  id           String  @id @default(cuid())
  // OSM element identity, e.g. "node/1234567". Unique so a re-run updates in
  // place instead of duplicating the whole dataset.
  osmId        String  @unique
  category     String // normalised to the spatial layer's own vocabulary, not raw OSM tags
  // The OSM tag this row was classified FROM, e.g. "leisure=garden".
  //
  // Without it the mapping is lossy and irreversible: a park row could have come
  // from leisure=park or leisure=garden, and nothing in the database can say
  // which — so a suspected mis-mapping cannot be measured, and correcting one
  // means re-fetching the country rather than reclassifying in place. That is
  // not theoretical; this vocabulary has already mis-grouped school/college and
  // restaurant/fast_food, and each fix cost a full re-seed.
  //
  // Nullable because rows seeded before this column exist and are not worth
  // discarding — null means "seeded before we recorded this", not "no tag".
  sourceTag    String?
  name         String?
  // Straight from OSM tags where a mapper recorded them — sparse in India and
  // shown only when present, never inferred. brand falls back to operator
  // (helps search: "ICICI" matches a branch whose name is just "ICICI Bank
  // ATM" or whose brand tag carries the chain).
  brand        String?
  openingHours String?
  lat          Decimal @db.Decimal(10, 7)
  lng          Decimal @db.Decimal(10, 7)
  city         String

  fetchedAt DateTime @default(now())

  @@index([category, lat, lng])
  @@index([city])
}

// Administrative boundaries from OpenStreetMap — wards, zones, districts.
//
// Two jobs. First, a cell can say where it actually IS ("Ward 173, Adyar
// Zone") instead of only what is near it. Second, and the reason the geometry
// is stored rather than just a name: an Indian ward is the unit civic data is
// published against, so this is the join key demographics will need. Storing
// only the resolved name would make that join impossible later.
//
// Still no PostGIS. The bbox columns below are a btree prefilter — typically
// a handful of candidate polygons — and ray-casting point-in-polygon runs in
// JS on those few. Same shape as PoiIndex's bbox-then-haversine, and the same
// tipping points apply (docs/spatial-intelligence.md §3).
//
// Seeded by scripts/fetch-osm-boundaries.mjs. Empty in a fresh checkout: the
// locality module then reports UNAVAILABLE, which reads as "we don't know
// which ward this is", never as "this place has no ward".
model Boundary {
  id         String  @id @default(cuid())
  // OSM relation identity, e.g. "relation/1234567" — unique so a re-run
  // updates in place instead of duplicating the dataset.
  osmId      String  @unique
  name       String
  // name:en where a mapper recorded one. Indian boundaries are frequently
  // tagged only in the state language; carrying both lets the UI show a
  // readable name without discarding the official one.
  nameLocal  String?
  // OSM's scale: 4=state, 5/6=district, 8=municipality, 9/10=ward/zone.
  // Kept as OSM's own numbering rather than remapped to our own vocabulary —
  // the numbers are the thing every other OSM consumer and the source data
  // itself speak, and a private renumbering would need translating back on
  // every refetch.
  adminLevel Int
  city       String?
  source     String  @default("openstreetmap")

  // GeoJSON coordinate rings (Polygon or MultiPolygon). Json for the same
  // reason SpatialContext.modules is: read whole, never filtered on.
  geometry Json

  // The prefilter. Real indexed columns precisely because this IS the filter —
  // the rule PoiIndex's comment states, applied.
  minLat Decimal @db.Decimal(10, 7)
  maxLat Decimal @db.Decimal(10, 7)
  minLng Decimal @db.Decimal(10, 7)
  maxLng Decimal @db.Decimal(10, 7)

  ingestedAt DateTime @default(now())

  @@index([adminLevel, minLat, maxLat])
  @@index([city])
}

// Where the water is — lakes, rivers, tanks, reservoirs and canals, as polygons.
//
// This closes `water_distance`, the only declared-but-absent input that two
// modules share: `terrain` (0.50 measured against a ceiling of 1.00) and
// `environment` (0.38 against 0.60). One ingestion, two modules — which is why
// it was ranked first in docs/spatial-research-2026-07-28.md.
//
// Same shape as Boundary above and for the same reasons: `geometry` is Json
// because it is read whole and never filtered on; the bbox is four REAL indexed
// columns because the bbox IS the filter. Still no PostGIS — nearest-edge
// distance runs in JS over the handful of rows the bbox scan returns
// (docs/spatial-intelligence.md §3 names what would change that).
//
// ⚠ NOT a flood input, and it must never be presented as one. Distance to water
// is the most tempting flood proxy that exists, and the standing refusal covers
// it: whether water actually collects somewhere depends on drains, pumps and
// what got built upstream last year, none of which is published as data. The
// refusal is enforced by tests/spatial-water.test.js, not by convention.
model WaterBody {
  id     String  @id @default(cuid())
  // "way/123" or "relation/456" — unique so a re-seed updates in place rather
  // than duplicating the dataset, the same contract PoiIndex and Boundary use.
  osmId  String  @unique
  // Genuinely optional: a large share of Indian tanks and ponds are mapped with
  // geometry and no name. They still count for distance; they just render as
  // "a lake" rather than by name.
  name   String?
  // Our own vocabulary (lake | river | reservoir | tank | pond | canal), mapped
  // from OSM tags by the seeder. Narrower than OSM's, because the only
  // distinctions worth carrying are the ones a reader would notice.
  kind   String
  city   String?
  source String  @default("openstreetmap")

  geometry Json
  // Lets the seeder drop puddles and the lookup prefer a lake over the drain
  // beside it. Nullable because a degenerate ring has no meaningful area.
  areaSqM  Float?

  minLat Decimal @db.Decimal(10, 7)
  maxLat Decimal @db.Decimal(10, 7)
  minLng Decimal @db.Decimal(10, 7)
  maxLng Decimal @db.Decimal(10, 7)

  ingestedAt DateTime @default(now())

  // Nearest-water is a bbox INTERSECTION test, not the containment test
  // Boundary does, so both axes get an index.
  @@index([minLat, maxLat])
  @@index([minLng, maxLng])
  @@index([city])
}

// Motorable roads, as lines. Closes `road_access` for `landContext` — at 0.19
// against a ceiling of 0.50, the weakest module in the layer.
//
// LAND only, and that is the point: "can a lorry actually get to this plot, or
// does the last 800 m run over a dirt track" is the question a plot buyer asks
// first, and until now the module could only decline to answer it.
//
// Two deliberate narrowings keep this table a fraction of OSM's road data:
//   - MOTORABLE classes only. footway/path/cycleway/steps are excluded — they
//     are the majority of highway=* ways in a mapped city and none of them can
//     carry a vehicle. `track` IS kept, because "reachable, but only by track"
//     is a real and important answer rather than an absent one.
//   - Geometry only, no routing attributes. This answers "how far to a road of
//     what class", not "how long is the drive". Drive time is routing's job
//     (routingProvider.js) and needs a graph, not a table.
//
// Same no-PostGIS pattern as WaterBody, one shape simpler: a road has no
// inside, so nearest-point is the only question (geometryDistance.js).
model RoadSegment {
  id      String   @id @default(cuid())
  osmId   String   @unique
  // Frequently absent and that is fine — an unnamed residential street still
  // proves access. The class carries the meaning here, not the name.
  name    String?
  // OSM's own `highway=` value, unmapped. Same reasoning as Boundary.adminLevel:
  // it is what the source data, every other OSM consumer and the seeder all
  // speak, and a private renumbering would need translating back on refetch.
  // ROAD_CLASS_RANK in roadLookup.js is where it gains an ordering.
  highway String
  // Physical width in metres where a mapper recorded one. Rare in India, but
  // decisive for a plot when present, so it is carried rather than inferred.
  widthM  Float?
  // `true` when surface= is a paved value. Null means unrecorded, which is NOT
  // the same as unpaved and must never be rendered as it.
  paved   Boolean?
  city    String?
  source  String   @default("openstreetmap")

  // LineString or MultiLineString.
  geometry Json

  minLat Decimal @db.Decimal(10, 7)
  maxLat Decimal @db.Decimal(10, 7)
  minLng Decimal @db.Decimal(10, 7)
  maxLng Decimal @db.Decimal(10, 7)

  ingestedAt DateTime @default(now())

  // The nearest-road scan narrows by class first (a plot cares about the
  // nearest DRIVEABLE road, not the nearest track), then by bbox.
  @@index([highway, minLat, maxLat])
  @@index([minLat, maxLat])
  @@index([minLng, maxLng])
  @@index([city])
}

// One row per ETL run, per dataset.
//
// What is near a CELL, in a shape a query can filter on.
//
// SpatialContext already knows this — but it knows it as JSON inside a module
// envelope, which reads whole and filters not at all. docs/spatial-intelligence.md
// states the trigger for promoting a value out of that JSON into a real column:
// when a FILTER needs it, not before. "Show me flats within 800 m of a metro"
// is that filter, and today it is impossible at any price.
//
// One row per (geohash, category) rather than one per (cell, POI). A relation
// row per POI pair would be tens of millions of rows to answer a question that
// only ever asks for the nearest and a couple of counts. This is the summary a
// filter consumes, and it is derived data — safe to delete and recompute.
//
// `nearestM` is haversine from the CELL CENTRE, so it is approximate at the
// property level by up to ~108 m. That is fine for a filter (the read path
// re-anchors exact distances per property via reanchor.js) but it is why this
// table must never be the source of a displayed number.
model CellPoiSummary {
  id       String @id @default(cuid())
  geohash  String
  category String

  // Null means "none of this category within the search radius" — distinct
  // from 0, and distinct from a missing row, which means "never computed".
  nearestM     Int?
  // Network walking metres to that same nearest POI, from the self-hosted
  // router (routingProvider.js). Null = router absent at compute time, or the
  // POI didn't snap to the street network — "not measured", never 0.
  nearestWalkM Int?
  count800M    Int  @default(0)
  count1600M   Int  @default(0)

  computedAt DateTime @default(now())

  // One summary per category per cell; a recompute upserts rather than
  // accumulating duplicates.
  @@unique([geohash, category])
  // The filter's access path: category first, then the distance predicate.
  @@index([category, nearestM])
}

// India Post's pincode directory — the ground truth a listing's location
// claims are checked against.
//
// Every location fact on a listing is the OWNER'S claim: address, pincode,
// state, even where the map pin sits. Nothing verified that pincode 560095 is
// actually Bengaluru, so a mistyped (or invented) pincode sailed through and a
// renter searching by area found listings that are not where they say they are.
//
// One row per POST OFFICE (~155k), several per pincode — a pincode is a
// delivery route set, not a polygon, and India publishes no official pincode
// boundaries. So this table answers "what does India Post say this pincode IS"
// (offices, district, state), which is exactly what a claim check needs. It
// deliberately cannot answer "which pincode contains this coordinate" — that
// would require boundary polygons this data does not honestly support.
//
// Seeded by scripts/fetch-pincode-directory.mjs from data.gov.in (free, the
// same key as CPCB). Pincodes change glacially; yearly refresh is plenty.
model PincodeDirectory {
  id         String   @id @default(cuid())
  pincode    String
  officeName String
  officeType String? // 'S.O' | 'B.O' | 'H.O'
  delivery   Boolean  @default(true)
  taluk      String?
  division   String?
  region     String?
  circle     String?
  district   String
  state      String
  fetchedAt  DateTime @default(now())

  // One row per office per pincode; a re-run updates in place.
  @@unique([pincode, officeName])
  // The lookup is always by pincode.
  @@index([pincode])
}

// The gap this closes: a partially-failed OSM fetch is currently invisible.
// The seeder prints a warning to a terminal nobody kept, the table ends up
// thinner than it should be, and the only symptom is a POI list that looks a
// bit sparse — indistinguishable from an area that genuinely is sparse, which
// is the one ambiguity this whole layer exists to avoid.
model DataQualityReport {
  id      String   @id @default(cuid())
  dataset String // 'poi_index' | 'boundaries' | 'weather_normals'
  // City, or null for a run that isn't city-scoped.
  scope   String?
  runAt   DateTime @default(now())

  recordCount     Int
  // % of rows carrying the fields that make a row useful — for POIs, a name.
  // Null when the dataset has no meaningful notion of partial completeness.
  completenessPct Float?
  // False when the run knew it was incomplete (a failed tile, a dead
  // endpoint). The single most important column here: it separates "this area
  // is sparse" from "we failed to fetch it".
  complete        Boolean @default(true)

  // Per-dataset detail — category counts, failed tiles, endpoints tried.
  notes Json?

  @@index([dataset, runAt])
}

// ─────────────────────────────────────────────────────────────────
// User safety — blocking and reporting a PERSON
// ─────────────────────────────────────────────────────────────────

// One row per (blocker, blocked) pair. Directional as a record — we always know
// who did the blocking — but the messaging gate reads it in BOTH directions:
// blocking someone must stop them reaching you, which is the entire point.
//
// Distinct from `User.isBlocked`, which is an ADMIN suspending an account
// platform-wide. This is one user protecting themselves from another, and the
// two must never be confused: a UserBlock has no effect on anything except the
// pair it names.
model UserBlock {
  id        String @id @default(cuid())
  blocker   User   @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User   @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String

  createdAt DateTime @default(now())

  // Idempotent by construction: blocking twice is the same fact, not two.
  @@unique([blockerId, blockedId])
  // The gate's access path — "is there a block between these two", asked on
  // every send and every conversation list.
  @@index([blockedId])
}

// A report against a PERSON, as opposed to PropertyReport's report against a
// listing. Kept separate rather than bolting a nullable userId onto that model:
// the categories barely overlap (a person cannot have FAKE_PHOTOS, a listing
// cannot HARASS), the moderation response differs, and a shared table would
// make every existing property-report query say "and where userId is null".
model UserReport {
  id         String @id @default(cuid())
  reporter   User   @relation("UserReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String
  reported   User   @relation("UserReportsAgainst", fields: [reportedId], references: [id], onDelete: Cascade)
  reportedId String

  category    UserReportCategory
  description String

  // The thread it happened in, when there is one. SetNull rather than Cascade:
  // deleting a conversation must not destroy the report that cites it — the
  // report is the evidence, and losing it because the abuser's thread went away
  // would be exactly backwards.
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  conversationId String?

  status    ReportStatus @default(PENDING)
  adminNote String?

  createdAt DateTime @default(now())

  @@index([reportedId])
  @@index([status])
}

enum UserReportCategory {
  HARASSMENT
  SPAM
  SCAM_OR_FRAUD
  IMPERSONATION
  HATE_OR_ABUSE
  OTHER
}
